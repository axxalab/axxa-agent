{
  "name": "axxa-agent",
  "version": "0.9.24",
  "description": "AXXA Agent (Obsidian plugin).",
  "license": "GPL-3.0-or-later",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "node scripts/size-report.mjs",
    "collect:hot": "node scripts/collect-hot.mjs",
    "deploy:output": "node scripts/deploy.mjs",
    "preview": "node scripts/preview/preview.mjs",
    "gen:logos": "node scripts/genLogos.mjs",
    "lote": "node scripts/lote.mjs"
  },
  "dependencies": {
    "preact": "^10.29.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@types/node": "^16.18.108",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.20.2",
    "eslint": "^10.11.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "lucide": "^1.25.0",
    "obsidian": "latest",
    "tslib": "^2.7.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^2.1.9"
  }
}
